# GoHighLevel Private Integration token (Settings > Private Integrations).
# Scopes needed: contacts.write, contacts.readonly, locations/customFields.readonly
# (add locations/customFields.write only if you need to create custom fields)
GHL_PRIVATE_TOKEN=

# GoHighLevel sub-account (location) ID
GHL_LOCATION_ID=

# Public URL of this site, used to build the "Copy my report link" URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the paid Action Plan PDFs are hosted, e.g. a signed-URL bucket.
# The file names are guessable (<edition>-<on|not-on>-waitlist.pdf), so this
# must be somewhere that issues expiring links — not a public folder.
# Unset means the thank-you page promises delivery by email and shows no
# download button.
PLANS_BASE_URL=
