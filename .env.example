# GoHighLevel Private Integration token (Settings > Private Integrations).
# Scopes needed: contacts.write, contacts.readonly, locations/customFields.readonly
# (add locations/customFields.write only if you need to create custom fields)
GHL_PRIVATE_TOKEN=

# GoHighLevel sub-account (location) ID
GHL_LOCATION_ID=

# Public URL of this site, used to build the "Copy my report link" URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. The Action Plan PDFs ship in public/plans and are served from
# /plans by default, so the download works without this.
#
# Those paths are guessable (<edition>-<on|not-on>-waitlist.pdf), so anyone can
# fetch a paid plan by typing the URL. Point this at a host that issues signed,
# expiring links to close that off — the thank-you page will use it instead.
PLANS_BASE_URL=
